<div class="tab-pane fade" id="UserAliases" role="tabpanel" aria-labelledby="UserAliases">
  <div class="card mb-4">
    <div class="card-header d-flex fs-5">
      <button class="btn d-md-none flex-grow-1 text-start" data-bs-target="#collapse-tab-UserAliases" data-bs-toggle="collapse" aria-controls="collapse-tab-UserAliases">
        {{ lang.user.user_aliases }}
      </button>
      <span class="d-none d-md-block">{{ lang.user.user_aliases }}</span>
    </div>
    <div id="collapse-tab-UserAliases" class="card-body collapse" data-bs-parent="#user-content">

      {# --- Synonym section --- #}
      <div class="row mb-4">
        <div class="col-12">
          <h6>{{ lang.user.user_alias_synonym_title }}</h6>
          {% if user_alias_config.synonym_set == 1 %}
            <p class="mb-1">
              {{ lang.user.user_alias_synonym_current }}:
              <strong>{{ user_alias_config.synonym }}@{{ mailboxdata.domain }}</strong>
            </p>
            <p class="text-muted small">{{ lang.user.user_alias_synonym_locked }}</p>
          {% else %}
            <p class="text-muted small">{{ lang.user.user_alias_synonym_info }}</p>
            <div class="input-group mb-2" style="max-width:480px">
              <input type="text" id="ua_synonym_input" class="form-control"
                placeholder="{{ lang.user.user_alias_synonym_placeholder }}"
                pattern="[a-z0-9][a-z0-9\-]{1,19}"
                maxlength="20"
                autocomplete="off">
              <span class="input-group-text">@{{ mailboxdata.domain }}</span>
              <button class="btn btn-warning" id="ua_synonym_btn" type="button">
                {{ lang.user.user_alias_synonym_set }}
              </button>
            </div>
            <div id="ua_synonym_feedback" class="small"></div>
          {% endif %}
        </div>
      </div>

      {# --- Add alias section --- #}
      <div class="row mb-3">
        <div class="col-12">
          <h6>{{ lang.user.user_alias_add_title }}</h6>
          <p class="text-muted small">{{ lang.user.user_alias_format_hint }}</p>
          <div class="input-group mb-2" style="max-width:600px">
            <input type="text" id="ua_prefix_input" class="form-control"
              placeholder="{{ lang.user.user_alias_prefix_placeholder }}"
              pattern="[a-z0-9][a-z0-9\-]*"
              autocomplete="off">
            <span class="input-group-text">-</span>
            <select id="ua_base_select" class="form-select" style="max-width:200px">
              <option value="{{ mailboxdata.local_part }}">{{ mailboxdata.local_part }}</option>
              {% if user_alias_config.synonym_set == 1 and user_alias_config.synonym %}
                <option value="{{ user_alias_config.synonym }}">{{ user_alias_config.synonym }}</option>
              {% endif %}
            </select>
            <span class="input-group-text">@{{ mailboxdata.domain }}</span>
            <button class="btn btn-success" id="ua_add_btn" type="button">
              <i class="bi bi-plus-lg"></i> {{ lang.user.user_alias_add }}
            </button>
          </div>
          <div id="ua_add_preview" class="text-muted small mb-1"></div>
          <div id="ua_add_feedback" class="small"></div>
        </div>
      </div>

      {# --- Alias list --- #}
      <div class="row">
        <div class="col-12">
          <table class="table table-striped table-sm" id="ua_alias_table">
            <thead>
              <tr>
                <th>{{ lang.user.user_alias_address }}</th>
                <th>{{ lang.user.user_alias_created }}</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="ua_alias_tbody">
              <tr id="ua_loading_row">
                <td colspan="3" class="text-center text-muted">
                  <span class="spinner-border spinner-border-sm me-1"></span>
                  {{ lang.user.loading }}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var domain = {{ mailboxdata.domain | json_encode | raw }};
  var localpart = {{ mailboxdata.local_part | json_encode | raw }};

  // ── helpers ──────────────────────────────────────────────────────────────
  function escHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function showMsg(el, type, msg) {
    el.className = 'small text-' + type;
    el.textContent = msg;
  }

  function clearMsg(el) { el.className = 'small'; el.textContent = ''; }

  // ── load alias list ───────────────────────────────────────────────────────
  function loadAliases() {
    var tbody = document.getElementById('ua_alias_tbody');
    tbody.innerHTML = '<tr id="ua_loading_row"><td colspan="3" class="text-center text-muted">'
      + '<span class="spinner-border spinner-border-sm me-1"></span></td></tr>';

    fetch('/api/v1/?query=get/user-alias', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        tbody.innerHTML = '';
        if (!Array.isArray(data) || data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="3" class="text-muted">'
            + escHtml(lang.user_alias_none) + '</td></tr>';
          return;
        }
        data.forEach(function (row) {
          var tr = document.createElement('tr');
          tr.innerHTML = '<td>' + escHtml(row.address) + '</td>'
            + '<td class="text-muted small">' + escHtml(row.created || '') + '</td>'
            + '<td class="text-end">'
            + '<button class="btn btn-sm btn-danger ua-del-btn" data-id="' + escHtml(row.id) + '">'
            + '<i class="bi bi-trash"></i></button></td>';
          tbody.appendChild(tr);
        });
        // bind delete buttons
        tbody.querySelectorAll('.ua-del-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (!confirm(lang.delete_ays)) return;
            deleteAlias(this.dataset.id);
          });
        });
      })
      .catch(function () {
        tbody.innerHTML = '<tr><td colspan="3" class="text-danger">Error loading aliases.</td></tr>';
      });
  }

  // ── delete alias ─────────────────────────────────────────────────────────
  function deleteAlias(id) {
    fetch('/api/v1/?query=delete/user-alias', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'items=' + encodeURIComponent(JSON.stringify([id]))
    })
    .then(function (r) { return r.json(); })
    .then(function () { loadAliases(); })
    .catch(function () {});
  }

  // ── live preview ─────────────────────────────────────────────────────────
  var prefixInput  = document.getElementById('ua_prefix_input');
  var baseSelect   = document.getElementById('ua_base_select');
  var addPreview   = document.getElementById('ua_add_preview');
  var addFeedback  = document.getElementById('ua_add_feedback');

  function updatePreview() {
    var prefix = prefixInput.value.trim();
    var base   = baseSelect.value;
    if (prefix.length > 0) {
      addPreview.textContent = prefix + '-' + base + '@' + domain;
    } else {
      addPreview.textContent = '';
    }
    clearMsg(addFeedback);
  }

  if (prefixInput)  prefixInput.addEventListener('input', updatePreview);
  if (baseSelect)   baseSelect.addEventListener('change', updatePreview);

  // ── add alias ─────────────────────────────────────────────────────────────
  var addBtn = document.getElementById('ua_add_btn');
  if (addBtn) {
    addBtn.addEventListener('click', function () {
      clearMsg(addFeedback);
      var prefix = prefixInput.value.trim().toLowerCase();
      var base   = baseSelect.value;

      if (!/^[a-z0-9][a-z0-9-]*$/.test(prefix)) {
        showMsg(addFeedback, 'danger', lang.user_alias_prefix_invalid);
        return;
      }

      var address = prefix + '-' + base + '@' + domain;

      addBtn.disabled = true;
      fetch('/api/v1/?query=add/user-alias', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'attr=' + encodeURIComponent(JSON.stringify({ address: address }))
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        addBtn.disabled = false;
        var ok = Array.isArray(data) && data.length > 0 && data[0].type === 'success';
        if (ok) {
          prefixInput.value = '';
          addPreview.textContent = '';
          showMsg(addFeedback, 'success', address + ' ' + lang.user_alias_added);
          loadAliases();
        } else {
          var msg = (Array.isArray(data) && data[0] && data[0].msg) ? data[0].msg : 'Error';
          showMsg(addFeedback, 'danger', Array.isArray(msg) ? msg.join(' ') : msg);
        }
      })
      .catch(function () {
        addBtn.disabled = false;
        showMsg(addFeedback, 'danger', 'Request failed.');
      });
    });
  }

  // ── set synonym ──────────────────────────────────────────────────────────
  var synonymInput    = document.getElementById('ua_synonym_input');
  var synonymBtn      = document.getElementById('ua_synonym_btn');
  var synonymFeedback = document.getElementById('ua_synonym_feedback');

  if (synonymBtn) {
    synonymBtn.addEventListener('click', function () {
      clearMsg(synonymFeedback);
      var synonym = synonymInput.value.trim().toLowerCase();

      if (!/^[a-z0-9][a-z0-9-]{1,19}$/.test(synonym)) {
        showMsg(synonymFeedback, 'danger', lang.user_alias_synonym_format_error);
        return;
      }

      if (!confirm(lang.user_alias_synonym_confirm)) return;

      synonymBtn.disabled = true;
      fetch('/api/v1/?query=add/user-synonym', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'attr=' + encodeURIComponent(JSON.stringify({ synonym: synonym }))
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var ok = Array.isArray(data) && data.length > 0 && data[0].type === 'success';
        if (ok) {
          location.reload();
        } else {
          synonymBtn.disabled = false;
          var msg = (Array.isArray(data) && data[0] && data[0].msg) ? data[0].msg : 'Error';
          showMsg(synonymFeedback, 'danger', Array.isArray(msg) ? msg.join(' ') : msg);
        }
      })
      .catch(function () {
        synonymBtn.disabled = false;
        showMsg(synonymFeedback, 'danger', 'Request failed.');
      });
    });
  }

  // ── init ─────────────────────────────────────────────────────────────────
  // Load alias list when tab becomes visible
  var tabBtn = document.querySelector('[data-bs-target="#UserAliases"]');
  if (tabBtn) {
    tabBtn.addEventListener('shown.bs.tab', loadAliases);
  }

  // Also load immediately if the tab is the active one on page load
  if (document.getElementById('UserAliases') &&
      document.getElementById('UserAliases').classList.contains('active')) {
    loadAliases();
  }

})();
</script>
